MONGODB_URI=mongodb+srv://justyourmemories_db_user:<db_password>@cluster0.qcu1cso.mongodb.net/justyourmemories?retryWrites=true&w=majority&appName=Cluster0
PORT=3000

# Public site URL (used in confirmation email links)
SITE_URL=https://justyourmemories.company

# Recommended for production (works on cloud hosts that block SMTP):
# Sign up at https://resend.com, verify justyourmemories.company, then set:
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=Just Your Memories <notifications@justyourmemories.company>

# Gmail SMTP fallback (works locally; many hosts block outbound SMTP):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=justyourmemories@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Auth (login, signup, admin dashboard)
AUTH_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=justyourmemories@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password-here
